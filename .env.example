APP_NAME=DesK Tattoo
APP_ENV=prod
API_BASE_URL=https://api.example.com
API_TIMEOUT_MS=15000

# Origine de la webapp (lien du QR d'accueil client)
WEB_APP_URL=https://TON-PROJET.vercel.app

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_..._or_eyJ...

# Stripe LIVE (publishable only — sk_live_ stays in Supabase secrets)
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRODUCT_ID=prod_...
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_LABEL=19,99 €

# Unique QR download link (smart redirect → stores)
APP_DOWNLOAD_URL=https://desktattoo.app/get/dt-get-7f3a9c2e
APP_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.desktattoo.desk_tattoo
